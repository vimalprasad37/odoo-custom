<odoo>
    <!-- Tree/List View -->
    <record id="view_course_tree" model="ir.ui.view">
        <field name="name">student.course.tree</field>
        <field name="model">student.course</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
                <field name="duration"/>
                <field name="student_ids"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_course_form" model="ir.ui.view">
        <field name="name">student.course.form</field>
        <field name="model">student.course</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="duration"/>
                        <field name="student_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

     <record id="action_courses" model="ir.actions.act_window">
        <field name="name">Courses</field>
        <field name="res_model">student.course</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_courses_action" parent="student_management.menu_student_root" action="action_courses"/>
</odoo>
