<?xml version="1.0" encoding="UTF-8"?>
<openerp>
	<data>
		<record id="sale_order_quick_inherit" model="ir.ui.view">
			<field name="name">sale.order.quick.inherit</field>
			<field name="model">sale.order</field>
			<field name="inherit_id" ref="sale.view_order_form" />
			<field name="arch" type="xml">
				<data>
					<xpath expr="//field[@name='order_line']" position="before">
						<button name="action_open_stock" class="btn-primary" type="object" string="Add Lines" attrs="{'invisible': [('state', 'not in', ['draft'])]}" />
					</xpath>
				</data>
			</field>
		</record>
	</data>
</openerp>
